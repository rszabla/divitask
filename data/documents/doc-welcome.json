    },
    "item-guide-1": {
      "id": "item-guide-1",
      "content": "Outliner: Press Enter for a new task, Tab to indent, Shift+Tab to outdent",
      "note": "You can nest tasks infinitely to break down complex goals into manageable steps.",
      "completed": true,
      "collapsed": false,
      "parentId": "item-guide",
      "childIds": [],
      "createdAt": "2026-09-01T09:00:00.000Z",
      "updatedAt": "2026-09-01T09:00:00.000Z"
    },
    "item-guide-2": {
      "id": "item-guide-2",
      "content": "Reorder & Focus: Drag the bullet to reorder; click bullet to focus on a subtree",
      "note": "On mobile, touch and drag any bullet up or down to rearrange tasks.",
      "completed": true,
      "collapsed": false,
      "parentId": "item-guide",
      "childIds": [],
      "createdAt": "2026-09-01T09:00:00.000Z",
      "updatedAt": "2026-09-01T09:00:00.000Z"
    },
    "item-guide-3": {
      "id": "item-guide-3",
      "content": "Timeline: Switch between Outline and Timeline with Alt+G or the top toggle",
      "note": "Drag time blocks horizontally to schedule, drag the edges to resize, or double-click any row to create a new block.",
      "completed": false,
      "collapsed": false,
      "parentId": "item-guide",
      "childIds": [],
      "createdAt": "2026-09-01T09:00:00.000Z",
