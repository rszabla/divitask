    "item-guide": {
      "id": "item-guide",
      "content": "🚀 Getting Started & Quick Tips #guide",
      "note": "DiviTask combines an infinite outliner with a zoomable Gantt timeline. Here are a few tips to get you started:",
      "completed": false,
      "collapsed": false,
      "parentId": null,
      "childIds": [
        "item-guide-1",
        "item-guide-2",
        "item-guide-3"
      ],
